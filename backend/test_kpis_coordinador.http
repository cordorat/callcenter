###############################################################################
# 1. LOGIN COORDINADOR
###############################################################################
### Login como coordinador
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "{{coordinadorEmail}}",
  "password": "{{coordinadorPassword}}"
}

