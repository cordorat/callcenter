PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "old_password": "agente123!",
  "new_password": "SoloLetras!",
  "new_password_confirm": "SoloLetras!"
}

