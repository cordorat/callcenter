### ==============================================
### 1. LOGIN COMO AGENTE (Copiar token después)
### ==============================================
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "agente123@callcenter.com",
  "password": "agente123!"
}

### ==============================================
### 2. CONSULTAR PERFIL (Criterio 1.3)
### GET /api/users/profile/
### ==============================================
GET {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}

### ==============================================
### 3. ACTUALIZAR SOLO INFORMACIÓN PERSONAL (Criterio 3.3)
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "first_name": "Carlos",
  "last_name": "Martínez",
  "email": "carlos.martinez@callcenter.com",
  "phone": "3001234567"
}

### ==============================================
### 4. VALIDACIÓN: Email sin @ (Criterio 2.5.1)
### Debe devolver error
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "email": "emailinvalido.com"
}

### ==============================================
### 5. VALIDACIÓN: Email sin .com/.co (Criterio 2.5.1)
### Debe devolver error
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "email": "usuario@ejemplo.net"
}

### ==============================================
### 6. VALIDACIÓN: Teléfono con letras (Criterio 2.5.2)
### Debe devolver error
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "phone": "300abc4567"
}

### ==============================================
### 7. VALIDACIÓN: Teléfono con más de 10 caracteres (Criterio 2.5.2)
### Debe devolver error
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "phone": "30012345678901"
}

### ==============================================
### 8. CAMBIAR SOLO CONTRASEÑA (Criterio 3.2)
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "old_password": "agente123!",
  "new_password": "NuevaPass1234!",
  "new_password_confirm": "NuevaPass1234!"
}

### ==============================================
### 9. VALIDACIÓN: Contraseña actual incorrecta (Criterio 3.1)
### Debe devolver error "Contraseña incorrecta"
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "old_password": "passwordIncorrecto",
  "new_password": "NuevaPass123!",
  "new_password_confirm": "NuevaPass123!"
}

### ==============================================
### 10. VALIDACIÓN: Nueva contraseña = actual (Criterio 2.3)
### Debe devolver error "La contraseña nueva no puede ser igual a la anterior"
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "old_password": "agente123!",
  "new_password": "agente123!",
  "new_password_confirm": "agente123!"
}

### ==============================================
### 11. VALIDACIÓN: Contraseñas no coinciden (Criterio 2.4)
### Debe devolver error "Las contraseñas no coinciden"
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "old_password": "agente123!",
  "new_password": "NuevaPass123!",
  "new_password_confirm": "OtraPass456#"
}

### ==============================================
### 12. VALIDACIÓN: Contraseña sin número (Criterio 2.2)
### Debe devolver error
