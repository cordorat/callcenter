Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "old_password": "agente123",
  "new_password": "NuevaPass123!"
}

### ==============================================
### 18. ACTUALIZAR PERFIL Y CONTRASEÑA JUNTOS
### Debe actualizar ambos y devolver ambos mensajes
### ==============================================
PATCH {{baseUrl}}/users/profile/
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "first_name": "Juan",
  "last_name": "Actualizado",
  "email": "juan.actualizado@callcenter.com",
  "phone": "3109876543",
  "old_password": "NuevaPass123!",
  "new_password": "OtraPass456#",
  "new_password_confirm": "OtraPass456#"
}

