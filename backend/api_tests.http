### ============================================
### 1. AUTENTICACIÓN
### ============================================

### 1.1 Login como Administrador
# @name loginAdmin
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "admin@callcenter.com",
  "password": "admin123"
}

### 1.2 Login como Agente (después de crear un agente)
# @name loginAgent
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "agente@callcenter.com",
  "password": "agente123"
}

### 1.3 Refrescar Token
POST {{baseUrl}}/auth/refresh/
Content-Type: application/json

{
  "refresh": "TU_REFRESH_TOKEN_AQUI"
}

### 1.4 Logout
POST {{baseUrl}}/auth/logout/
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "refresh": "TU_REFRESH_TOKEN_AQUI"
}

### ============================================
### 2. GESTIÓN DE USUARIOS (Administrador)
### ============================================

### 2.1 Listar todos los usuarios
GET {{baseUrl}}/users/
Authorization: Bearer {{adminToken}}

### 2.2 Crear un nuevo Agente
# @name createAgent
POST {{baseUrl}}/users/
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "agente@callcenter.com",
  "first_name": "Juan",
  "last_name": "Pérez",
  "phone": "+1234567890",
  "documento_id": "1234567890",
  "foto_perfil": "https://ejemplo.com/fotos/juan.jpg",
  "role": "AGENT",
  "password": "agente123!",
  "password_confirm": "agente123!",
  "is_active": true
}

### 2.3 Crear otro Agente
POST {{baseUrl}}/users/
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "maria.gomez@callcenter.com",
  "first_name": "María",
  "last_name": "Gómez",
  "phone": "+9876543210",
  "role": "AGENT",
  "password": "maria123",
  "password_confirm": "maria123",
  "is_active": true
}

### 2.4 Crear un nuevo Administrador (solo administradores pueden)
POST {{baseUrl}}/users/
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "admin2@callcenter.com",
  "first_name": "Carlos",
  "last_name": "Rodríguez",
  "phone": "+1122334455",
  "role": "ADMIN",
  "password": "admin456",
  "password_confirm": "admin456",
  "is_active": true
}

### 2.5 Ver detalles de un usuario específico
GET {{baseUrl}}/users/2/
Authorization: Bearer {{adminToken}}

### 2.6 Actualizar un usuario
PATCH {{baseUrl}}/users/2/
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "first_name": "Juan Carlos",
  "phone": "+1234567899"
}

### 2.7 Desactivar un usuario
DELETE {{baseUrl}}/users/2/
Authorization: Bearer {{adminToken}}

### 2.8 Activar un usuario desactivado
POST {{baseUrl}}/users/2/activate/
Authorization: Bearer {{adminToken}}

### ============================================
### 3. PERFIL DE USUARIO
### ============================================

### 3.1 Ver mi perfil (cualquier usuario autenticado)
GET {{baseUrl}}/users/me/
Authorization: Bearer {{adminToken}}

### 3.2 Cambiar mi contraseña
POST {{baseUrl}}/users/change_password/
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "old_password": "admin123",
  "new_password": "newAdmin123!",
  "new_password_confirm": "newAdmin123!"
}

### ============================================
### 4. OPERACIONES DE AGENTES
### ============================================

### 4.1 Listar usuarios (como agente - solo verá su propio perfil)
GET {{baseUrl}}/users/
Authorization: Bearer {{agentToken}}

### 4.2 Ver mi perfil (como agente)
GET {{baseUrl}}/users/me/
Authorization: Bearer {{agentToken}}

### 4.3 Actualizar mi perfil (como agente)
PATCH {{baseUrl}}/users/2/
Content-Type: application/json
Authorization: Bearer {{agentToken}}

{
  "first_name": "Juan Carlos",
  "phone": "+1234567800"
}

### 4.4 Intentar crear usuario (como agente - DEBE FALLAR)
POST {{baseUrl}}/users/
Content-Type: application/json
Authorization: Bearer {{agentToken}}

{
  "email": "test@callcenter.com",
  "first_name": "Test",
  "last_name": "User",
  "role": "AGENT",
  "password": "test123",
  "password_confirm": "test123"
}

### 4.5 Intentar ver otro usuario (como agente - DEBE FALLAR)
GET {{baseUrl}}/users/1/
Authorization: Bearer {{agentToken}}

### ============================================
### 5. CASOS DE VALIDACIÓN
### ============================================

### 5.1 Login con credenciales incorrectas
POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
  "email": "admin@callcenter.com",
  "password": "contraseña_incorrecta"
}

### 5.2 Crear usuario con contraseñas que no coinciden
POST {{baseUrl}}/users/
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "test@callcenter.com",
  "first_name": "Test",
  "last_name": "User",
  "role": "AGENT",
  "password": "password123",
  "password_confirm": "password456"
}

### 5.3 Crear usuario con email duplicado
POST {{baseUrl}}/users/
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "admin@callcenter.com",
  "first_name": "Otro",
  "last_name": "Admin",
  "role": "AGENT",
  "password": "password123",
  "password_confirm": "password123"
}

### 5.4 Acceder sin token (DEBE FALLAR)
GET {{baseUrl}}/users/

### 5.5 Acceder con token inválido (DEBE FALLAR)
GET {{baseUrl}}/users/
Authorization: Bearer token_invalido_aqui

### ============================================
### 6. PAGINACIÓN
### ============================================

### 6.1 Listar usuarios con paginación (página 1)
GET {{baseUrl}}/users/?page=1
Authorization: Bearer {{adminToken}}

### 6.2 Listar usuarios con paginación (página 2)
GET {{baseUrl}}/users/?page=2
Authorization: Bearer {{adminToken}}

### ============================================
### NOTAS:
### ============================================
# 1. Después de hacer login, copia el token "access" de la respuesta
# 2. Reemplaza {{adminToken}} con el token del administrador
# 3. Reemplaza {{agentToken}} con el token del agente
# 4. Los IDs de usuario pueden variar según el orden de creación
# 5. El servidor debe estar corriendo en http://localhost:8000
