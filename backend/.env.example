# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================

# Django Secret Key (CAMBIAR EN PRODUCCIÓN)
SECRET_KEY=tu-secret-key-super-secreta-cambiala-en-produccion

# Debug Mode (SIEMPRE False en producción)
DEBUG=True

# Allowed Hosts (separar con comas)
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=callcenter_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# TWILIO CONFIGURATION
# =============================================================================

# Twilio Account Credentials
# Obtener de: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+573001234567

# Twilio API Keys (para autenticación de cliente)
# Crear en: https://console.twilio.com/us1/develop/voice/manage/api-keys
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here

# Twilio TwiML App SID
# Crear en: https://console.twilio.com/us1/develop/voice/manage/twiml-apps
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# CELERY & REDIS CONFIGURATION
# =============================================================================

# Redis URL para Celery
# Formato: redis://[usuario:password@]host:puerto/db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# JWT CONFIGURATION (Opcional - valores por defecto en settings.py)
# =============================================================================

# Tiempo de vida de tokens
# JWT_ACCESS_TOKEN_LIFETIME=8  # horas
# JWT_REFRESH_TOKEN_LIFETIME=7  # días

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# URL base del sitio (para webhooks de Twilio)
# En desarrollo: http://localhost:8000 o tu URL de ngrok
# En producción: https://tu-dominio.com
SITE_URL=http://localhost:8000

# URL del frontend (para enlaces de recuperación de contraseña)
# En desarrollo: http://localhost:5173 (Vite)
# En producción: https://tu-frontend.com
FRONTEND_URL=http://localhost:5173

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Backend de email
# Desarrollo: django.core.mail.backends.console.EmailBackend (imprime en consola)
# Producción: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuración SMTP (para producción)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_password_o_app_password
DEFAULT_FROM_EMAIL=noreply@callcenter.com

# Nota: Para Gmail, necesitas crear una "App Password"
# https://myaccount.google.com/apppasswords

# =============================================================================
# ITERACIÓN AUTOMÁTICA - CONFIGURACIÓN
# =============================================================================

# Máximo de intentos por cliente
MAX_INTENTOS=3

# Tiempo de espera entre reasignaciones (segundos)
TIEMPO_ESPERA_REASIGNACION=30

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. NO subir este archivo con valores reales al repositorio
# 2. Crear archivo .env con los valores reales (está en .gitignore)
# 3. En producción, usar variables de entorno del servidor
# 4. Cambiar SECRET_KEY antes de desplegar
# 5. Configurar Twilio para llamadas reales
# 6. Instalar y ejecutar Redis antes de usar Celery
