# ============================================================
#           CONFIGURACIÓN DEL SISTEMA CALL CENTER
# ============================================================
# 
# INSTRUCCIONES:
# 1. Copie este archivo y renómbrelo a ".env"
# 2. Complete TODOS los valores marcados como OBLIGATORIO
# 3. Los valores con "default" son opcionales
#
# ============================================================

# ==================== BASE DE DATOS ====================
# Credenciales para PostgreSQL (puede dejar los valores por defecto)
DB_NAME=callcenter
DB_USER=postgres
DB_PASSWORD=postgres123

# ==================== DJANGO ====================
# Clave secreta para Django (genere una clave única y segura)
# Puede generar una en: https://djecrety.ir/
SECRET_KEY=django-insecure-cambie-esto-por-una-clave-segura-y-larga

# Modo debug (False en producción)
DEBUG=False

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================== TWILIO (OBLIGATORIO) ====================
# Obtenga estas credenciales en: https://console.twilio.com
#
# Account SID: Se encuentra en la página principal de la consola
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token: Se encuentra en la página principal de la consola
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Número de teléfono Twilio (formato E.164, ej: +1234567890)
TWILIO_PHONE_NUMBER=+1234567890

# TwiML App SID (opcional, para llamadas entrantes)
TWILIO_TWIML_APP_SID=

# ==================== ASSEMBLYAI (OBLIGATORIO) ====================
# Obtenga su API Key en: https://www.assemblyai.com/dashboard
#
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
#                    FIN DE CONFIGURACIÓN
# ============================================================
